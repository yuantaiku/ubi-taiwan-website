---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ubi from '../../data/ubi-content.json';

// 基本收入大哉問：14 題，取代改版前只有 3 題的 /qa/。
// 文案逐字取自團隊規格（docs/content-specs/01-what-is-ubi.md）。
// 每題有獨立錨點（#q1…#q14），可單獨分享；FAQPage 結構化資料讓單題能被搜尋到——
// 這也是把大哉問獨立成頁、而非併入單一長頁的主要理由之一。

const faq = ubi.faq as Array<{ q: string; paras: string[] }>;

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.paras.join('\n') },
  })),
});
---

<BaseLayout
  title="基本收入大哉問｜UBI Taiwan"
  description="會讓人不想工作嗎？錢從哪裡來？會造成通膨嗎？為什麼要發給有錢人？14 個關於無條件基本收入最常見的疑問，逐題以實證研究回應。"
  current="ubi-faq"
>
  <section class="head">
    <div class="container">
      <p class="eyebrow">認識基本收入</p>
      <h1>基本收入大哉問</h1>
      <p class="head__lead">
        關於基本收入，被問得最多的十四個問題。每一題都盡量以各國實驗數據與制度設計來回應，
        而不是只講理念。你可以直接點下面的問題跳到答案。
      </p>

      <nav class="toc" aria-label="問題索引">
        <ol>
          {faq.map((f, i) => (
            <li>
              <a href={`#q${i + 1}`}>
                <span class="toc__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="toc__q">{f.q}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="bar">
        <h2 id="faq-title" class="visually-hidden">問答</h2>
        <button type="button" class="bar__toggle" data-expand aria-pressed="false">全部展開</button>
      </div>

      <div class="faq">
        {faq.map((f, i) => (
          <details class="q" id={`q${i + 1}`}>
            <summary>
              <span class="q__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="q__t">{f.q}</span>
              <span class="q__chev" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="18" height="18" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M3 6l5 5 5-5" />
                </svg>
              </span>
            </summary>
            <div class="q__a">
              {f.paras.map((p) => <p>{p}</p>)}
              <p class="q__perma"><a href={`#q${i + 1}`}>連結到這一題</a></p>
            </div>
          </details>
        ))}
      </div>

      <nav class="more" aria-label="其他主題問答">
        <h2>其他主題的問答</h2>
        <ul>
          <li>
            <a href="/life-freedom/#lf-faq-title">關於「生活自由計畫」的問答 →</a>
            <span>報名資格、金額用途、退出機制</span>
          </li>
          <li>
            <a href="/support/#faq-title">關於捐款的問答 →</a>
            <span>收據、抵稅、定期定額、愛心碼</span>
          </li>
        </ul>
      </nav>
    </div>
  </section>

  <script type="application/ld+json" set:html={faqJsonLd} />
</BaseLayout>

<style>
  .head { padding-block: var(--space-16) var(--space-12); background: var(--surface-subtle); }
  .head__lead {
    max-width: var(--container-narrow);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--color-ink-700);
    margin-bottom: var(--space-8);
  }

  /* ── 問題索引 ── */
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-8);
  }
  .toc li { break-inside: avoid; margin-bottom: var(--space-1); }
  .toc a {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    text-decoration: none;
    color: var(--color-ink-700);
    border-radius: var(--radius-sm);
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }
  .toc a:hover { background: var(--color-white); color: var(--color-brand-700); }
  .toc__n {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-brand-500);
  }
  .toc__q { font-size: var(--text-sm); line-height: 1.5; }

  /* ── 展開控制 ── */
  .bar { display: flex; justify-content: flex-end; margin-bottom: var(--space-4); }
  .bar__toggle {
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-brand-700);
    background: transparent;
    border: 1px solid var(--color-brand-300);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-6);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .bar__toggle:hover { background: var(--color-brand-50); }

  /* ── 問答 ── */
  .faq { display: grid; }
  .q { border-top: 1px solid var(--color-ink-300); scroll-margin-top: var(--space-8); }
  .q:last-of-type { border-bottom: 1px solid var(--color-ink-300); }
  .q summary {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-6) var(--space-2) var(--space-6) 0;
    cursor: pointer;
    list-style: none;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .q summary::-webkit-details-marker { display: none; }
  .q summary:hover { background: var(--surface-subtle); }
  .q__n {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--color-brand-200);
    line-height: 1;
    transition: color var(--duration-base) var(--ease-out);
  }
  .q__t { font-size: var(--text-xl); font-weight: var(--font-bold); text-wrap: balance; }
  .q__chev { color: var(--color-ink-500); align-self: center; transition: transform var(--duration-base) var(--ease-out); }
  .q[open] .q__chev { transform: rotate(180deg); }
  .q[open] .q__n { color: var(--color-warm-500); }
  .q[open] .q__t { color: var(--color-brand-700); }

  .q__a {
    padding: 0 var(--space-8) var(--space-8) 3.5rem;
    max-width: 62rem;
    color: var(--color-ink-700);
    line-height: var(--leading-loose);
  }
  .q__perma { margin: var(--space-4) 0 0; font-size: var(--text-sm); }
  .q__perma a { color: var(--color-ink-500); text-decoration: none; }
  .q__perma a:hover { color: var(--color-brand-600); text-decoration: underline; }

  /* ── 其他主題 ── */
  .more { margin-top: var(--space-16); }
  .more h2 { font-size: var(--text-xl); margin-bottom: var(--space-4); }
  .more ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .more li { display: grid; gap: var(--space-1); }
  .more span { font-size: var(--text-sm); color: var(--color-ink-500); }

  @media (max-width: 860px) {
    .toc ol { columns: 1; }
    .q summary { grid-template-columns: 2.5rem 1fr auto; gap: var(--space-3); }
    .q__a { padding: 0 0 var(--space-6) 2.5rem; }
  }
</style>

<script>
  // 全部展開／收合。錨點進站時自動展開對應題目，讓 #q7 這類連結可直接分享。
  const btn = document.querySelector<HTMLButtonElement>('[data-expand]');
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('.q'));

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-pressed') === 'true';
    items.forEach((d) => { d.open = !open; });
    btn.setAttribute('aria-pressed', String(!open));
    btn.textContent = open ? '全部展開' : '全部收合';
  });

  function openFromHash() {
    const id = location.hash.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ block: 'start' });
    }
  }

  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
